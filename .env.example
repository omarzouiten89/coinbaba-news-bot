# ===== المفاتيح السرية =====
# 1) نسخ هاد الملف وسميه .env
# 2) عمّر القيم بيدك. ما تصيفط هاد الملف لحتى واحد وما تحطوش في المحادثة.

# Token ديال البوت (من @BotFather)
BOT_TOKEN=

# من my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# من aistudio.google.com > Get API key
GEMINI_API_KEY=
# سمية النموذج (خليه كيف ما هو إلا ما قلت ليك نبدلوه)
GEMINI_MODEL=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite

# (اختياري) الرقم ديال حسابك باش يصيفط ليك البوت تنبيهات المشاكل.
# كتعرفو من @userinfobot. وخاصك تبدا محادثة مع البوت ديالك (/start) مرة وحدة.
OWNER_CHAT_ID=

# 1 = تجربة: كيطبع المنشورات في الشاشة بلا ما ينشر
DRY_RUN=1
